---
const { current = '' } = Astro.props;
const links = [
  { href: '/garage/s14/', label: 'THE GARAGE', id: 'garage' },
  { href: '/build-log/', label: 'BUILD LOG', id: 'log' },
  { href: '/#events', label: 'EVENTS', id: 'events' },
  { href: '#contact', label: 'CONTACT', id: 'contact' },
];
---
<header class="top">
  <nav class="wrap bar" aria-label="Main">
    <a class="brand" href="/">
      <span class="display brand-mark">BS GARAGE</span>
    </a>
    <input type="checkbox" id="menu-toggle" class="menu-toggle" aria-label="Toggle menu" />
    <label for="menu-toggle" class="burger btn cyan sm" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </label>
    <div class="links label">
      {links.map((l) => (
        <a class:list={['navlink', { current: current === l.id }]} href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="btn sm" href="/build-log/">FOLLOW THE BUILD</a>
    </div>
  </nav>
</header>
<style>
  .top { background: var(--raised); border-bottom: 4px solid var(--outline); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-top: 16px; padding-bottom: 16px; }
  .brand { display: flex; align-items: baseline; gap: 8px; text-decoration: none; color: var(--text); }
  .brand:hover { color: var(--text); }
  .brand-mark { font-weight: 900; font-size: 32px; line-height: 36px; letter-spacing: -.01em; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .navlink { color: var(--text); text-decoration: none; }
  .navlink:hover { color: var(--link); }
  .navlink.current { color: var(--link); text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .menu-toggle, .burger { display: none; }
  @media (max-width: 760px) {
    .brand-mark { font-size: 26px; line-height: 32px; }
    .burger { display: inline-flex; width: 48px; justify-content: center; padding: 0; cursor: pointer; }
    .menu-toggle { display: block; position: absolute; opacity: 0; width: 1px; height: 1px; }
    .menu-toggle:focus-visible + .burger { outline: 3px solid var(--focus); outline-offset: 3px; }
    .links { display: none; flex-basis: 100%; flex-direction: column; align-items: stretch; gap: 0; border-top: 4px solid var(--outline); padding-top: 8px; }
    .menu-toggle:checked ~ .links { display: flex; }
    .navlink { min-height: 48px; display: flex; align-items: center; border-bottom: 2px solid var(--hair); }
    .links .btn { margin-top: 12px; justify-content: center; }
  }
</style>

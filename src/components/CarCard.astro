---
import type { CollectionEntry } from 'astro:content';
interface Props { car: CollectionEntry<'cars'> }
const { car } = Astro.props;
const d = car.data;
---
<article class="card car">
  <div class={`ph bg-${d.color}`}>
    {d.hero
      ? <img src={d.hero.src} alt={d.hero.alt} loading="lazy" decoding="async" />
      : <span class="label on-bright">[PHOTO: {d.code}]</span>}
  </div>
  <div class="body stack">
    <div class="stack" style="gap:4px">
      <span class="label muted">{d.year}</span>
      <h3 class="display h-title">{d.name}</h3>
    </div>
    <p style="margin:0">{d.blurb}</p>
    <div class="tags">
      <span class={`pill bg-${d.statusColor} on-bright`}>{d.status}</span>
      {d.tags.map((t) => <span class="pill">{t}</span>)}
    </div>
    <a class="more" href={`/garage/${car.id}/`}><strong>Open the {d.short} page</strong></a>
  </div>
</article>
<style>
  .car { overflow: hidden; display: flex; flex-direction: column; }
  .ph { aspect-ratio: 16 / 10; border-bottom: 4px solid var(--ink); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 24px; gap: 16px; flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .more { margin-top: auto; }
  .on-bright { color: var(--ink); }
</style>
